# DATABASE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_NAME=DB_Name
POSTGRES_SSLMODE=disable

# WEB SERVER
SERVER_PORT=8080
SERVER_SWAGGER_ROUTE=swagger
SERVER_MODE=development

# TOKEN
TOKEN_SECRET=mysecret
TOKEN_ISSUER=Recho
TOKEN_RT_TTL=720h # RT -> Refresh Token
TOKEN_AT_TTL=1h   # AT -> Access Token

# STORAGE
STORAGE_DRIVER=local # local | s3

# Local storage (used when STORAGE_DRIVER=local)
STORAGE_LOCAL_ROOT_PATH=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8000/uploads

# S3 / S3-compatible storage (used when STORAGE_DRIVER=s3)
# Leave STORAGE_S3_ENDPOINT empty and STORAGE_S3_USE_PATH_STYLE=false for AWS S3.
# For MinIO / R2 / Spaces set the endpoint and keep path style enabled.
STORAGE_S3_ENDPOINT=http://localhost:9000 # Empty for AWS; e.g. http://localhost:9000 for MinIO.
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=recho
STORAGE_S3_ACCESS_KEY_ID=minioadmin # Optional, falls back to the default AWS credential chain.
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_USE_PATH_STYLE=true    # Required by most S3-compatible providers.
STORAGE_S3_DISABLE_ACL=false      # set true for buckets with ACLs disabled (new AWS S3 buckets)
STORAGE_S3_PUBLIC_BASE_URL=       # optional CDN / custom domain used by GetURL
STORAGE_S3_PRESIGN_EXPIRY=15m